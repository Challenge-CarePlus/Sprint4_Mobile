{
  "buildCommand": "npx expo export --platform web --clear",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self' blob: data: https://*.onrender.com https://cdn.jsdelivr.net"
        }
      ]
    }
  ]
}
